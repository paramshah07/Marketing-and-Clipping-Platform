{
  "openapi": "3.1.0",
  "info": {
    "title": "Clipper",
    "version": "0.1.0"
  },
  "paths": {
    "/api/clips": {
      "get": {
        "summary": "List Clips",
        "operationId": "list_clips",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClipOut"
                  },
                  "type": "array",
                  "title": "Response List Clips"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload Clip",
        "description": "Multipart upload, streamed to raw/. The clip is UPLOADING while the bytes arrive, then PROBING.",
        "operationId": "upload_clip",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": ".mp4, .mov or .webm"
                  },
                  "rights_status": {
                    "type": "string",
                    "enum": [
                      "permission_granted",
                      "none",
                      "own_content"
                    ]
                  },
                  "source_creator_handle": {
                    "type": "string"
                  }
                },
                "type": "object",
                "required": [
                  "file",
                  "rights_status"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClipOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/clips/from-url": {
      "post": {
        "summary": "Create Clip From Url",
        "operationId": "create_clip_from_url",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClipFromUrl"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClipOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
