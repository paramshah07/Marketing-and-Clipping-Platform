{
  "openapi": "3.1.0",
  "info": {
    "title": "Clipper",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Status",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "SystemStatus": {
        "properties": {
          "db": {
            "type": "boolean",
            "title": "Db"
          },
          "worker_alive": {
            "type": "boolean",
            "title": "Worker Alive"
          },
          "worker_last_heartbeat": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Last Heartbeat"
          },
          "jobs": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Jobs"
          }
        },
        "type": "object",
        "required": [
          "db",
          "worker_alive",
          "worker_last_heartbeat",
          "jobs"
        ],
        "title": "SystemStatus"
      }
    }
  }
}
