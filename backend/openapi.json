              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Clip",
        "description": "Only READY/FAILED clips with no renders (delete the renders first). Files go too.",
        "operationId": "delete_clip",
        "parameters": [
          {
            "name": "clip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Clip Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/clips/{clip_id}/retry": {
      "post": {
        "summary": "Retry Clip",
        "description": "FAILED -> PROBING again if the bytes are here, else DOWNLOADING again (url clips).",
        "operationId": "retry_clip",
