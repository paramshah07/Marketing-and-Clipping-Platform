# Production's only public entry point (compose.prod.yml, docs/deploy.md): HTTPS with an automatic Let's
# Encrypt certificate, in front of the api, which has its own sign-in. Both values come from the VM's .env.
{
	# With an email Caddy falls back to ZeroSSL: sslip.io is not on the Public Suffix List, so every *.sslip.io
	# site shares one Let's Encrypt quota (50 certificates a week), which runs out.
	email {$CLIPPER_ACME_EMAIL}
}

{$CLIPPER_HOST} {
	# The bot service calls api:8000 directly, with its bearer and X-Clipper-User (the user it acts as), and is the
	# only caller of /api/internal/*: from outside, none of them exists. (The api checks the bearer too.)
	request_header -Authorization
	request_header -X-Clipper-User
	respond /api/internal/* 404
	reverse_proxy api:8000 # streams request bodies: 2 GB clip uploads pass, no size cap
}
