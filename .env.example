# Clipper settings. Copy to .env (gitignored, never commit it): cp .env.example .env
# Every setting and its default: backend/app/core/config.py

# Zernio API key: zernio.com -> API keys. Starts with sk_. Needed for Sync accounts and publishing.
ZERNIO_API_KEY=

# false: scheduled posts stay SCHEDULED and nothing reaches Instagram (the UI says "Publishing off").
# true: due posts are published as real Reels, which cannot be deleted through Zernio.
PUBLISHING_ENABLED=false

# Optional: the Telegram bot (does everything the web app does, docs/telegram-bot.md) and failure alerts.
# Token: @BotFather -> /newbot. Chat id: send your bot any message, then open
# https://api.telegram.org/bot<token>/getUpdates and copy result[].message.chat.id (this works while the bot
# service is off, as it is until both are set). The bot answers this chat only: use your private chat with
# it, not a group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: more bots (own @BotFather token + chat each), same account, served by compose's `bot2` /
# `bot3` services. Copy TELEGRAM_BOT_TOKEN_N / TELEGRAM_CHAT_ID_N and add a matching botN service for a
# fourth.
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_ID_2=
TELEGRAM_BOT_TOKEN_3=
TELEGRAM_CHAT_ID_3=
