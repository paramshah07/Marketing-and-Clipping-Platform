# Clipper settings. Copy to .env (gitignored, never commit it): cp .env.example .env
# Every setting and its default: backend/app/core/config.py. compose.yml hands each container only what it needs:
# every service blanks the secrets it must not hold. Production's own lines (COMPOSE_FILE, CLIPPER_HOST,
# CLIPPER_ACME_EMAIL, APP_BASE_URL): docs/deploy.md section 1.

# false: scheduled posts stay SCHEDULED and nothing reaches Instagram (the UI says "Publishing off").
# true: due posts are published as real Reels, each with its user's own Zernio key. They cannot be deleted
# through Zernio.
PUBLISHING_ENABLED=false

# Where browsers open the app: sign-in cookies are Secure when it is https, every change must come from this
# origin, and Telegram pairing links point here. Dev default: Vite's address; production: https://CLIPPER_HOST
# (compose.prod.yml sets it).
# APP_BASE_URL=http://localhost:5173

# The app's two secrets. On the VM deploy.sh adds both on its first run (never printed). Keep a copy of that
# SECRETS_KEY in a password manager, as a backup (without it every user pastes their Zernio key and bot tokens
# again), and never put either in another machine's .env. Never set SECRETS_KEY in a .env that still holds the
# operator's ZERNIO_API_KEY or TELEGRAM_* (the Mac's): the next migrate (even `docker compose run --rm worker
# pytest`'s) imports production's key and bots into that database, for good. For a local stack without them:
#   echo "SECRETS_KEY=$(openssl rand -base64 32 | tr '+/' '-_')" >> .env
#   echo "BOT_SERVICE_SECRET=$(openssl rand -hex 32)" >> .env
# SECRETS_KEY: Fernet key(s) sealing each user's Zernio key and bot tokens in the database (comma-separated to
# rotate: the first seals, any opens). Unset: no stored key opens, so nobody can save a key or publish.
# BOT_SERVICE_SECRET: the bot service's bearer, with which it acts as each bot's owner. Unset: no bots run.
# SECRETS_KEY=
# BOT_SERVICE_SECRET=

# Users. Anyone can sign up (username + password) until MAX_USERS users are enabled, the operator included.
# A new user may store USER_QUOTA_BYTES of clips and renders (the operator: no cap; `python -m app.cli
# set-quota <username> <GB|none>` changes it). Nobody can upload, import or render while the disk has less
# than MIN_FREE_BYTES free.
# MAX_USERS=15
# USER_QUOTA_BYTES=5368709120
# MIN_FREE_BYTES=3221225472

# User 1, the operator (read by the migrate service's `python -m app.cli bootstrap`, every other container gets
# them blanked). CLIPPER_USER renames it (default: clipper). CLIPPER_PASSWORD_HASH becomes its password while it
# has none: a bcrypt hash, base64-encoded so compose has no `$` to expand (docs/deploy.md section 1). Or set one:
#   docker compose exec api python -m app.cli set-password clipper
# CLIPPER_USER=
# CLIPPER_PASSWORD_HASH=

# Zernio keys and Telegram bots are per user: each pastes their own in Settings (bots: as many as they like).
# Operator only, one-shot: an install from before accounts existed has ZERNIO_API_KEY, TELEGRAM_BOT_TOKEN /
# TELEGRAM_CHAT_ID (the alerts bot) and _2 / _3 (interactive only) here. Once SECRETS_KEY is set, the migrate
# service imports them into user 1, once (users.env_imported_at); after that they are ignored and can go. New
# installs leave them out.
